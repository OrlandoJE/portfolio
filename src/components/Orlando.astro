---
import DownArrow from "./DownArrow.astro";
---

<main class="relative flex flex-col justify-center items-center w-full h-svh">
  <h1 class="mb-1">orlando</h1>
  <nav class="flex flex-col justify-center items-center text-lg">
    <a href="/studio">studio</a>
    <a href="/dev">dev</a>
    <a href="/r&d">r&d</a>
    <!-- <a href='/blog'>blog</a> -->
  </nav>
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2">
    <DownArrow />
  </div>
</main>

<style>
  a {
    margin: calc(1rem / 8) 0;
  }
  a::after {
    content: "";
    position: absolute;
    width: 400%;
    height: 1px;
    bottom: 0px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      #007bff8b 30%,
      #007bff8b 50%,
      #007bff8b 70%,
      transparent 100%
    );
    border-radius: 999px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease-in-out;
  }

  a:hover::after {
    transform: scaleX(1);
  }
</style>
